{
  "name": "@alexandregme/zl-quality-kit",
  "version": "2.0.1",
  "description": "Shared ESLint 9, Prettier and Stylelint configs for React/Next.js projects, with a zl-lint init command.",
  "keywords": [
    "eslint",
    "prettier",
    "stylelint",
    "config",
    "react",
    "nextjs",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Alexandre Mendes",
  "homepage": "https://github.com/alexandregme/zl-quality-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandregme/zl-quality-kit.git"
  },
  "bugs": {
    "url": "https://github.com/alexandregme/zl-quality-kit/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "zl-lint": "bin/zl-lint.mjs"
  },
  "exports": {
    "./eslint": "./configs/eslint.config.mjs",
    "./prettier": "./configs/prettier.config.mjs",
    "./stylelint": "./configs/stylelint.config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "configs",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:fix": "eslint . --fix && prettier --write . && stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
    "test": "node --test",
    "prepare": "husky"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^16.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-tailwindcss": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "commitlint": "^19.8.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1"
  }
}
